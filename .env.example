# ==================================
# RFPs.ai Environment Variables
# ==================================
# Copy this file to .env and fill in your values
# See TEAM_SETUP.md for detailed instructions

# ============= REQUIRED =============

# Database Connection (Get from Supabase Dashboard)
# Settings → Database → Connection string → Transaction pooler → URI
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres"

# Auth Secret (Generate with: openssl rand -base64 32)
# Each developer can use their own for local dev
# Production uses shared secret from team vault
BETTER_AUTH_SECRET=""

# Auth Base URL
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# ============= OPTIONAL =============

# AI Providers (Get your own keys for development)
OPENROUTER_API_KEY=""         # openrouter.ai
ANTHROPIC_API_KEY=""          # console.anthropic.com
OPENAI_API_KEY=""             # platform.openai.com
XAI_API_KEY=""                # x.ai
GOOGLE_GENERATIVE_AI_API_KEY="" # ai.google.dev
GROQ_API_KEY=""               # console.groq.com

# Search APIs
EXA_API_KEY=""                # exa.ai
TAVILY_API_KEY=""             # tavily.com
BRAVE_API_KEY=""              # brave.com/search/api

# Web Crawling
FIRECRAWL_API_KEY=""          # firecrawl.dev

# Memory/Context
MEM0_API_KEY=""               # mem0.ai

# Email
RESEND_API_KEY=""             # resend.com

# Caching (Optional)
REDIS_URL=""                  # Redis connection string

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Client-side (Optional)
NEXT_PUBLIC_BETTER_AUTH_URL=""

# Node Environment
NODE_ENV="development"
