# This is a local development environment file
# Copy to .env.local and fill in your actual values

# Database (Supabase or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rfpsai"

# Better Auth (generate a random 32+ character string)
BETTER_AUTH_SECRET="your-secret-key-here-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# AI Providers (OpenRouter/DeepSeek is primary, Anthropic is fallback)
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY="sk-ant-your-key-here"
OPENAI_API_KEY=""
XAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""

# Search APIs (optional for Phase 1)
EXA_API_KEY=""
TAVILY_API_KEY=""
BRAVE_API_KEY=""

# Crawling (optional for Phase 1)
FIRECRAWL_API_KEY=""

# Memory (optional for Phase 1)
MEM0_API_KEY=""

# Email (optional for Phase 1)
RESEND_API_KEY=""

# Redis (optional)
REDIS_URL=""

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
